{
  "$comment": "앱(RN)과 웹(종목정보·공지)이 함께 쓰는 이벤트 분류표. 이름은 GA4 규칙(소문자 snake_case, 40자 이하), 매개변수 값은 개인정보 없이. 문서: docs/analytics-taxonomy.md",
  "version": 1,
  "events": {
    "login": {
      "source": ["app"],
      "params": {"method": "password | biometric", "lock_enabled": "boolean"},
      "description": "로그인 성공"
    },
    "screen_view": {
      "source": ["app", "web"],
      "params": {"screen_name": "watchlist | quote | settings | bench | stock_info | notices | notice_detail"},
      "description": "화면 진입(GA4 권장 이벤트)"
    },
    "select_symbol": {
      "source": ["app"],
      "params": {"symbol": "종목 코드"},
      "description": "관심종목에서 종목 선택"
    },
    "switch_quote_tab": {
      "source": ["app"],
      "params": {"symbol": "종목 코드", "tab": "book | chart | info"},
      "description": "호가·차트·정보 탭 전환"
    },
    "change_chart_interval": {
      "source": ["app"],
      "params": {"symbol": "종목 코드", "interval": "1m | 5m"},
      "description": "차트 봉 간격 변경"
    },
    "open_order_sheet": {
      "source": ["app"],
      "params": {"symbol": "종목 코드", "side": "bid | ask", "entry": "book | button | web"},
      "description": "주문 창 열기. entry=web이면 웹뷰에서 연 것"
    },
    "submit_order": {
      "source": ["app"],
      "params": {"symbol": "종목 코드", "side": "bid | ask", "order_type": "limit | market"},
      "description": "주문 버튼을 누름(금액·수량은 보내지 않음)"
    },
    "order_result": {
      "source": ["app"],
      "params": {"symbol": "종목 코드", "result": "filled | partial | accepted | rejected | unknown | failed", "confirmed_by_lookup": "boolean"},
      "description": "주문 결과 확정. confirmed_by_lookup=true면 타임아웃 뒤 조회로 확정"
    },
    "view_stock_info": {
      "source": ["web"],
      "params": {"symbol": "종목 코드", "in_app": "boolean"},
      "description": "종목정보 웹 화면 표시"
    },
    "click_order_from_web": {
      "source": ["web"],
      "params": {"symbol": "종목 코드", "side": "bid | ask"},
      "description": "웹 화면의 매수·매도 버튼"
    },
    "view_notice": {
      "source": ["web"],
      "params": {"notice_id": "공지 ID", "category": "service | maintenance | event"},
      "description": "공지 상세 열기"
    },
    "filter_notices": {
      "source": ["web"],
      "params": {"category": "all | service | maintenance | event"},
      "description": "공지 분류 선택"
    },
    "change_language": {
      "source": ["app"],
      "params": {"from": "ko | en | id | th", "to": "ko | en | id | th"},
      "description": "언어 변경"
    },
    "bridge_rejected": {
      "source": ["app"],
      "params": {"reason": "origin | schema | version | size | rate", "type": "메시지 종류(알 수 없으면 unknown)"},
      "description": "웹뷰 브리지가 메시지를 거절함(보안·호환성 모니터링)"
    }
  }
}
