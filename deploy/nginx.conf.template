# Hoga 로컬 클러스터 앞단(nginx). deploy/cluster.sh가 gateway 수만큼 upstream을 채워 만든다.
#   /ws  → gateway 여러 대(least_conn: 연결이 적은 쪽으로. 웹소켓은 오래 붙어 있어 round-robin보다 고르다)
#   나머지 → market 1대(주문·인증·스냅샷·웹 화면·관리 콘솔)
worker_processes auto;
worker_rlimit_nofile 65535;
pid __RUN__/nginx.pid;
error_log __RUN__/nginx-error.log warn;

events {
  worker_connections 20000;
  multi_accept on;
}

http {
  access_log off;
  client_body_temp_path __RUN__/tmp/body;
  proxy_temp_path __RUN__/tmp/proxy;
  fastcgi_temp_path __RUN__/tmp/fastcgi;
  uwsgi_temp_path __RUN__/tmp/uwsgi;
  scgi_temp_path __RUN__/tmp/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  upstream gateways {
    least_conn;
__GATEWAYS__
  }

  upstream market {
    server 127.0.0.1:__MARKET_PORT__;
    keepalive 64;
  }

  server {
    listen 127.0.0.1:__PORT__ backlog=4096;

    location /ws {
      proxy_pass http://gateways;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      # 죽은 gateway에는 연결 실패로 바로 다음 gateway를 시도한다(수동 헬스 체크)
      proxy_next_upstream error timeout;
      proxy_connect_timeout 2s;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
    }

    location / {
      proxy_pass http://market;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header X-Forwarded-For $remote_addr;
    }
  }
}
