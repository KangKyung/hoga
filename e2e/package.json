{
  "name": "@hoga/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Appium + WebdriverIO: one test suite for iOS and Android",
  "type": "module",
  "scripts": {
    "appium": "APPIUM_HOME=./.appium appium --port 4723 --log-level warn",
    "drivers": "APPIUM_HOME=./.appium appium driver install xcuitest; APPIUM_HOME=./.appium appium driver install uiautomator2",
    "test:ios": "PLATFORM=ios wdio run wdio.conf.ts",
    "test:android": "PLATFORM=android wdio run wdio.conf.ts",
    "bench:ios": "PLATFORM=ios wdio run wdio.conf.ts --spec specs/bench.e2e.ts",
    "bench:android": "PLATFORM=android wdio run wdio.conf.ts --spec specs/bench.e2e.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.9.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "webdriverio": "^9.32.0"
  }
}
